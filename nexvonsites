            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            overflow: hidden;
            text-decoration: none;
        }
        @keyframes gradienteWS {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .botao-ws::before {
            content: '';
            position: absolute;
            top: -50%; left: -50%;
            width: 200%; height: 200%;
            background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.35), transparent 60%);
            pointer-events: none;
        }
        .botao-ws:hover {
            transform: scale(1.15) rotate(6deg);
            box-shadow: 
                0 0 35px rgba(0, 230, 118, 0.6),
                0 0 70px rgba(0, 200, 83, 0.35),
                0 0 100px rgba(0, 150, 136, 0.2);
        }
        .botao-ws svg {
            width: 36px;
            height: 36px;
            fill: #fff;
            filter: drop-shadow(0 0 4px rgba(0,0,0,0.2));
            z-index: 1;
        }
        .anel-externo {
            position: absolute;
            width: 84px;
            height: 84px;
            border-radius: 50%;
            border: 1px solid rgba(0, 230, 118, 0.35);
            animation: anelPulsar 2.5s infinite;
        }
        .anel-externo:nth-child(2) {
            animation-delay: 0.8s;
            width: 96px;
            height: 96px;
            border-color: rgba(0, 200, 83, 0.2);
        }
        @keyframes anelPulsar {
            0% { transform: scale(1); opacity: 0.8; }
            100% { transform: scale(1.5); opacity: 0; }
        }
        .rotulo-ws {
            position: absolute;
            right: 95px;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(2, 6, 23, 0.9);
            padding: 0.8rem 1.2rem;
            border-radius: 12px;
            font-size: 0.85rem;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transition: all 0.3s ease;
            border: 1px solid rgba(0, 230, 118, 0.25);
            box-shadow: 0 0 20px rgba(0, 230, 118, 0.15);
        }
        .whatsapp-flutuante:hover .rotulo-ws {
            opacity: 1;
            transform: translateY(-50%) translateX(-5px);
        }

        /* RODAPÉ */
        footer {
            border-top: 1px solid rgba(0, 240, 255, 0.15);
            padding: 4rem 2.5rem 3rem;
            text-align: center;
            margin-top: 3rem;
