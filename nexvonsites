        .logo-rodape {
            font-weight: 800;
            font-size: 1.5rem;
            margin-bottom: 1rem;
            background: linear-gradient(90deg, var(--primario), var(--destaque));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .texto-rodape {
            color: rgba(255,255,255,0.5);
            margin-bottom: 0.5rem;
        }
        .assinatura {
            margin-top: 2rem;
            padding-top: 2rem;
            border-top: 1px solid rgba(0, 240, 255, 0.08);
            color: rgba(255,255,255,0.35);
            font-size: 0.85rem;
            letter-spacing: 2px;
        }

        /* RESPONSIVIDADE */
        @media (max-width: 1200px) {
            .painel-estatisticas { grid-template-columns: repeat(2, 1fr); }
            .grade-recursos { grid-template-columns: repeat(2, 1fr); }
        }
        @media (max-width: 768px) {
            h1 { font-size: 2rem; }
            .menu-navegacao { display: none; }
            .painel-estatisticas { grid-template-columns: 1fr; }
            .grade-recursos { grid-template-columns: 1fr; }
            .secao, .principal { padding-left: 1.2rem; padding-right: 1.2rem; }
            .whatsapp-flutuante { bottom: 20px; right: 20px; }
            .botao-ws { width: 62px; height: 62px; }
            .botao-ws svg { width: 30px; height: 30px; }
        }
    </style>
</head>
