    <!-- Fallback de fontes — sem depender de links externos -->
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        :root {
            --primario: #00F0FF;
            --secundario: #7928CA;
            --destaque: #FF00E5;
            --dourado: #FFE600;
            --sucesso-ws: #00E676;
            --escuro: #020617;
            --meio-escuro: #0F172A;
            --vidro: rgba(0, 240, 255, 0.06);
            --vidro-escuro: rgba(15, 23, 42, 0.85);
        }

        body {
            font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', sans-serif;
            background: var(--escuro);
            color: #FFFFFF;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* FUNDO QUÂNTICO — ANO 2100 */
        .fundo-quantico {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: 
                radial-gradient(ellipse at 10% 10%, rgba(0, 240, 255, 0.12) 0%, transparent 50%),
                radial-gradient(ellipse at 90% 90%, rgba(121, 40, 202, 0.15) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 50%, rgba(255, 0, 229, 0.08) 0%, transparent 60%),
                linear-gradient(180deg, #020617 0%, #071025 50%, #020617 100%);
            z-index: -3;
        }

        /* GRADE DE REDE QUÂNTICA */
        .grade-quantica {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: 
                linear-gradient(rgba(0, 240, 255, 0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 240, 255, 0.05) 1px, transparent 1px);
            background-size: 60px 60px;
            z-index: -2;
            animation: gradeFlutuar 20s linear infinite;
        }
        @keyframes gradeFlutuar {
            0% { transform: translate(0, 0); }
            100% { transform: translate(60px, 60px); }
        }

        /* PARTÍCULAS FLUTUANTES */
        .particulas {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: -1;
            overflow: hidden;
            pointer-events: none;
        }
        .particula {
            position: absolute;
            width: 4px; height: 4px;
            background: var(--primario);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--primario), 0 0 20px var(--primario);
            animation: flutuar 15s infinite ease-in-out;
        }
        @keyframes flutuar {
            0% { transform: translateY(100vh) scale(0); opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { transform: translateY(-100px) scale(1); opacity: 0; }
        }

        /* LINHA DE ENERGIA HORIZONTAL */
        .linha-topo {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 3px;
            background: linear-gradient(90deg, var(--primario), var(--secundario), var(--destaque), var(--dourado), var(--primario));
            background-size: 400% 100%;
            animation: brilhoLinha 4s linear infinite;
            z-index: 9999;
        }
        @keyframes brilhoLinha {
            0% { background-position: 0% 50%; }
            100% { background-position: 400% 50%; }
        }

        /* CABEÇALHO FUTURISTA */
        header {
            padding: 1.5rem 2.5rem;
            position: sticky;
            top: 0;
            z-index: 999;
            backdrop-filter: blur(25px);
            background: rgba(2, 6, 23, 0.7);
            border-bottom: 1px solid rgba(0, 240, 255, 0.15);
        }
        .navegacao {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .marca {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .logo-simbolo {
            width: 50px; height: 50px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--primario), var(--secundario));
            display: flex; align-items: center; justify-content: center;
            font-weight: 900; font-size: 1.5rem;
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.4), inset 0 0 15px rgba(255,255,255,0.2);
            animation: pulsarLogo 3s ease-in-out infinite;
        }
        @keyframes pulsarLogo {
            0%,100% { box-shadow: 0 0 25px rgba(0, 240, 255, 0.4), inset 0 0 15px rgba(255,255,255,0.2); }
            50% { box-shadow: 0 0 40px rgba(0, 240, 255, 0.6), inset 0 0 25px rgba(255,255,255,0.3); }
        }
        .logo-texto {
            font-weight: 800;
            font-size: 1.8rem;
            letter-spacing: 3px;
            background: linear-gradient(90deg, #FFFFFF, var(--primario), #FFFFFF);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: brilhoTexto 4s linear infinite;
        }
        @keyframes brilhoTexto {
            0% { background-position: -200% center; }
            100% { background-position: 200% center; }
        }
        .tag-futuro {
            font-size: 0.65rem;
            letter-spacing: 2px;
            color: var(--primario);
            opacity: 0.7;
            margin-top: 2px;
        }
        .menu-navegacao {
            display: flex; gap: 2.5rem; align-items: center;
        }
        .menu-navegacao a {
            color: rgba(255,255,255,0.75);
            text-decoration: none;
            font-size: 1.05rem;
            font-weight: 500;
            letter-spacing: 1px;
            position: relative;
            transition: all 0.3s;
        }
        .menu-navegacao a::after {
            content: '';
            position: absolute;
            bottom: -6px; left: 0; width: 0; height: 2px;
            background: linear-gradient(90deg, var(--primario), var(--destaque));
            transition: width 0.3s ease;
        }
        .menu-navegacao a:hover { color: var(--primario); }
        .menu-navegacao a:hover::after { width: 100%; }
        .botao-primario {
            padding: 0.85rem 2rem;
            background: linear-gradient(135deg, var(--primario), var(--secundario));
            border: none; border-radius: 8px;
            color: #000;
            font-weight: 700; font-size: 0.95rem;
            letter-spacing: 1px;
            cursor: pointer;
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.35);
            transition: all 0.4s;
            text-decoration: none;
        }
        .botao-primario:hover {
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 0 40px rgba(0, 240, 255, 0.5), 0 0 80px rgba(121, 40, 202, 0.3);
        }

        /* SEÇÃO PRINCIPAL — HOLOGRAMA */
        .principal {
            max-width: 1400px;
            margin: 0 auto;
            padding: 5rem 2.5rem 8rem;
            text-align: center;
            position: relative;
        }
        .etiqueta-sistema {
            display: inline-block;
            padding: 0.5rem 1.5rem;
            border: 1px solid rgba(0, 240, 255, 0.35);
            border-radius: 50px;
            font-size: 0.75rem;
            letter-spacing: 3px;
            color: var(--primario);
            margin-bottom: 2.5rem;
            background: rgba(0, 240, 255, 0.05);
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.1) inset;
        }
        h1 {
            font-size: 3.5rem;
            line-height: 1.15;
            margin-bottom: 2rem;
        }
        h1 span {
            background: linear-gradient(90deg, var(--primario), var(--destaque), var(--dourado));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-size: 300% auto;
            animation: gradienteBrilho 6s linear infinite;
        }
        @keyframes gradienteBrilho {
            0% { background-position: 0% center; }
            100% { background-position: 300% center; }
        }
        .subtitulo-principal {
            font-size: 1.3rem;
            color: rgba(255,255,255,0.65);
            max-width: 900px;
            margin: 0 auto 3rem;
            line-height: 1.8;
        }
        .grupo-botoes {
            display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap; margin-bottom: 5rem;
        }
        .botao-glitch {
            padding: 1.1rem 2.8rem;
            background: linear-gradient(135deg, var(--primario), var(--secundario));
            border: none; border-radius: 10px;
            color: #000;
            font-weight: 800; font-size: 1.05rem;
            letter-spacing: 1px;
            cursor: pointer;
            position: relative; overflow: hidden;
            box-shadow: 0 0 30px rgba(0, 240, 255, 0.4);
            transition: all 0.3s;
            text-decoration: none; display: inline-block;
        }
        .botao-glitch:hover {
            transform: translateY(-4px);
            box-shadow: 0 0 50px rgba(0, 240, 255, 0.6), 0 0 100px rgba(121, 40, 202, 0.4);
        }
        .botao-contorno {
            padding: 1.1rem 2.8rem;
            background: transparent;
            border: 2px solid;
            border-image: linear-gradient(135deg, var(--primario), var(--destaque)) 1;
            border-radius: 10px;
            color: #FFFFFF;
            font-weight: 700; font-size: 1.05rem;
            letter-spacing: 1px;
            cursor: pointer;
            position: relative;
            transition: all 0.3s;
            text-decoration: none; display: inline-block;
        }
        .botao-contorno:hover {
            background: linear-gradient(135deg, rgba(0, 240, 255, 0.1), rgba(121, 40, 202, 0.1));
            box-shadow: 0 0 30px rgba(0, 240, 255, 0.25);
        }

        /* PAINEL DE ESTATÍSTICAS FLUTUANTE */
        .painel-estatisticas {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-top: 3rem;
        }
        .cartao-estatistica {
            background: var(--vidro);
            border: 1px solid rgba(0, 240, 255, 0.15);
            border-radius: 16px;
            padding: 2rem 1.5rem;
            backdrop-filter: blur(15px);
            position: relative;
            overflow: hidden;
            transition: all 0.4s;
        }
        .cartao-estatistica::before {
            content: '';
            position: absolute;
            top: 0; left: -100%; width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(0, 240, 255, 0.1), transparent);
            transition: left 0.6s ease;
        }
        .cartao-estatistica:hover::before { left: 100%; }
        .cartao-estatistica:hover {
            border-color: rgba(0, 240, 255, 0.4);
            transform: translateY(-8px);
            box-shadow: 0 20px 60px rgba(0, 240, 255, 0.1);
        }
        .numero-estatistica {
            font-size: 2.5rem;
            font-weight: 800;
            background: linear-gradient(90deg, var(--primario), var(--destaque));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 0.5rem;
        }
        .rotulo-estatistica {
            font-size: 0.95rem;
            color: rgba(255,255,255,0.55);
            letter-spacing: 1px;
        }

        /* SEÇÕES GERAIS */
        .secao {
            max-width: 1400px;
            margin: 0 auto;
            padding: 5rem 2.5rem;
        }
        .cabecalho-secao {
            text-align: center;
            margin-bottom: 4rem;
        }
        .cabecalho-secao h2 {
            font-size: 2.4rem;
            margin-bottom: 1rem;
        }
        .cabecalho-secao h2 span {
            color: var(--primario);
        }
        .linha-divisoria {
            width: 80px; height: 4px;
            background: linear-gradient(90deg, var(--primario), var(--secundario), var(--destaque));
            margin: 0 auto;
            border-radius: 2px;
        }

        /* RECURSOS */
        .grade-recursos {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
        }
        .cartao-recurso {
            background: var(--vidro);
            border: 1px solid rgba(0, 240, 255, 0.12);
            border-radius: 18px;
            padding: 2.5rem;
            backdrop-filter: blur(20px);
            position: relative;
            transition: all 0.4s ease;
        }
        .cartao-recurso::after {
            content: '';
            position: absolute;
            inset: -1px;
            border-radius: 18px;
            background: linear-gradient(135deg, var(--primario), var(--destaque), var(--dourado));
            opacity: 0;
            transition: opacity 0.4s;
            z-index: -1;
        }
        .cartao-recurso:hover {
            transform: translateY(-10px);
            border-color: transparent;
        }
        .cartao-recurso:hover::after { opacity: 0.15; }
        .icone-recurso {
            font-size: 2.8rem;
            margin-bottom: 1.5rem;
            display: inline-block;
            filter: drop-shadow(0 0 15px currentColor);
        }
        .cartao-recurso h3 {
            font-size: 1.2rem;
            margin-bottom: 1rem;
            color: var(--primario);
        }
        .cartao-recurso p {
            color: rgba(255,255,255,0.6);
            line-height: 1.7;
        }

        /* TECNOLOGIA */
        .faixa-tecnologia {
            background: linear-gradient(90deg, rgba(0, 240, 255, 0.05), rgba(121, 40, 202, 0.05), rgba(255, 0, 229, 0.05));
